# syntax=docker/dockerfile:1

# =====================================================================
# Stage 1 — build the React frontend into static assets.
# =====================================================================
FROM node:20-slim AS frontend-builder

WORKDIR /app/frontend
# Copy manifests. yarn.lock is gitignored in this repo, so make it optional:
# without a lockfile yarn resolves fresh (slower first build, but always works).
COPY frontend/package.json ./
RUN corepack enable && yarn install --network-timeout 600000

# Now copy the rest of the frontend source and build it.
# REACT_APP_BACKEND_URL is empty on purpose: the built app makes relative
# /api/... calls, which the same FastAPI server (below) also serves.
COPY frontend/ ./
ENV REACT_APP_BACKEND_URL=""
ENV DISABLE_ESLINT_PLUGIN="true"
ENV CI="false"
RUN yarn build

# =====================================================================
# Stage 2 — Python backend + Playwright + the built React assets.
# =====================================================================
FROM mcr.microsoft.com/playwright/python:v1.63.0-jammy

WORKDIR /app

# System deps (Pillow, fonts for OCR fallback rendering).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg-dev zlib1g-dev fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

# Python deps — slim, runtime only.
COPY local-runner/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
      --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ \
      -r /app/requirements.txt \
 && playwright install chromium

# Backend source
COPY backend /app/backend
# React static bundle copied from stage 1
COPY --from=frontend-builder /app/frontend/build /app/frontend/build

WORKDIR /app/backend
EXPOSE 8001
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
